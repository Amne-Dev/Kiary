<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="EncryptedDiary.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    >
    <Grid>
        <Grid.KeyboardAccelerators>
            <KeyboardAccelerator x:ConnectionId='2' Key="F" Modifiers="Control"                                           />
        </Grid.KeyboardAccelerators>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid x:ConnectionId='3' x:Name="TitleBarDragRegion" Grid.Row="0" Padding="16,8,16,4" ColumnSpacing="12">
            <StackPanel Orientation="Vertical" Spacing="2">
                <TextBlock Text="Kiary" FontSize="24" FontWeight="SemiBold" />
            </StackPanel>
        </Grid>

        <MenuBar Grid.Row="1" Margin="16,0,16,4">
            <MenuBarItem Title="File">
                <MenuFlyoutItem x:ConnectionId='31' Text="Save"                          />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem x:ConnectionId='32' Text="Import..."                            />
                <MenuFlyoutItem x:ConnectionId='33' Text="Export..."                            />
            </MenuBarItem>
            <MenuBarItem Title="Edit">
                <MenuFlyoutItem x:ConnectionId='30' Text="Find..."                            />
            </MenuBarItem>
            <MenuBarItem Title="Help">
                <MenuFlyoutItem x:ConnectionId='28' Text="Documentation"                                     />
                <MenuFlyoutItem x:ConnectionId='29' Text="About"                             />
            </MenuBarItem>
        </MenuBar>

        <Grid Grid.Row="2" Padding="16,0,16,10" ColumnSpacing="14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderThickness="1" CornerRadius="12" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Entries" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:ConnectionId='27' Grid.Column="1"
                                Content="+"
                                Width="38"
                                Height="34"
                                Padding="0"
                                FontSize="22"
                                FontWeight="SemiBold"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                                             />
                    </Grid>
                    <ListView x:ConnectionId='19' x:Name="EntryList"
                              Grid.Row="1"
                                                                           
                                                                 
                              IsItemClickEnabled="False"
                              VerticalAlignment="Stretch"
                              HorizontalAlignment="Stretch">
                        <ListView.ContextFlyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:ConnectionId='23' Text="Rename Entry"                                   />
                                <MenuFlyoutItem x:ConnectionId='24' Text="Duplicate Entry"                                      />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:ConnectionId='25' Text="Delete Entry"                                   />
                            </MenuFlyout>
                        </ListView.ContextFlyout>
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Spacing="2" Padding="2">
                                    <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding DisplayUpdated}" Opacity="0.75" FontSize="12" />
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Expander x:ConnectionId='20' x:Name="TimedJournalExpander"
                              Grid.Row="2"
                              Header="Timed Journal"
                              ExpandDirection="Up"
                              IsExpanded="True"
                              HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Stretch"
                              VerticalAlignment="Bottom"
                              Margin="0,12,0,0">
                        <ListView x:ConnectionId='21' x:Name="TimedJournalList"
                                                                                      
                                  IsItemClickEnabled="False"
                                  MaxHeight="240"
                                  VerticalAlignment="Stretch"
                                  HorizontalAlignment="Stretch">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Display}" Padding="2" TextTrimming="CharacterEllipsis" />
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </Expander>
                </Grid>
            </Border>

            <Grid Grid.Column="1" RowSpacing="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:ConnectionId='5' x:Name="RichToolbar" Grid.Row="0" BorderThickness="1" CornerRadius="10" Padding="8">
                    <Grid ColumnSpacing="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <Button x:ConnectionId='13' x:Name="BoldButton" Content="B" FontWeight="Bold"                          />
                            <Button x:ConnectionId='14' x:Name="ItalicButton" Content="I" FontStyle="Italic"                            />
                            <Button x:ConnectionId='15' x:Name="UnderlineButton" Content="U"                               />
                            <ComboBox x:ConnectionId='16' x:Name="FontSizeCombo"
                                      Width="88"
                                                                                       >
                                <ComboBoxItem Content="12" />
                                <ComboBoxItem Content="14" />
                                <ComboBoxItem Content="16" />
                                <ComboBoxItem Content="18" />
                                <ComboBoxItem Content="20" />
                                <ComboBoxItem Content="24" />
                                <ComboBoxItem Content="28" />
                                <ComboBoxItem Content="32" />
                            </ComboBox>
                            <ComboBox x:ConnectionId='17' x:Name="FontColorCombo"
                                      Width="170"
                                                                                        >
                                <ComboBoxItem Tag="#1C2A37" Content="Ink Blue" />
                                <ComboBoxItem Tag="#0A5C99" Content="Ocean Blue" />
                                <ComboBoxItem Tag="#226B2A" Content="Leaf Green" />
                                <ComboBoxItem Tag="#7A2D8F" Content="Plum" />
                                <ComboBoxItem Tag="#9A4F00" Content="Amber" />
                                <ComboBoxItem Tag="#9A1F1F" Content="Crimson" />
                            </ComboBox>
                            <Button x:ConnectionId='18' Content="Clear Format"                                 />
                        </StackPanel>
                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    Spacing="8"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center">
                            <Button x:ConnectionId='11' x:Name="NewTimedSectionButton"
                                    Content="New Timed"
                                    Visibility="Collapsed"
                                                                        />
                            <ComboBox x:ConnectionId='12' x:Name="ModeCombo"
                                      Width="150"
                                                                                   >
                                <ComboBoxItem Tag="RichText" Content="Rich Text" />
                                <ComboBoxItem Tag="Markdown" Content="Markdown" />
                            </ComboBox>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border x:ConnectionId='6' x:Name="RichEditorHost" BorderThickness="1" CornerRadius="12" Padding="8">
                        <RichEditBox x:ConnectionId='10' x:Name="RichEditor"
                                                                         
                                                                                   
                                     VerticalAlignment="Stretch"
                                     HorizontalAlignment="Stretch" />
                    </Border>

                    <Border x:ConnectionId='7' x:Name="MarkdownEditorHost"
                            BorderThickness="1"
                            CornerRadius="12"
                            Padding="8"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock x:ConnectionId='8' x:Name="TimedJournalHint"
                                       Text="Timed Journal syntax detected lines are collapsible. Format example: 14/02/2026@09:30pm : Reflection"
                                       Opacity="0.72"
                                       TextWrapping="Wrap"
                                       Margin="0,0,0,8" />
                            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:ConnectionId='9' x:Name="TimedSectionPanel" Spacing="8" />
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="3" Padding="16,8">
            <TextBlock x:ConnectionId='4' x:Name="StatusText" Text="Locked vault. Enter your master password." Opacity="0.82" />
        </Border>
    </Grid>
</Window>

