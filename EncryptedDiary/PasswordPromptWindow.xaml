<Window x:Class="EncryptedDiary.PasswordPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Unlock Diary"
        Width="440"
        Height="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow"
        Background="#F6FBFF">
    <Window.Resources>
        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Background" Value="#E9F6FF" />
            <Setter Property="Foreground" Value="#1D2C3A" />
            <Setter Property="BorderBrush" Value="#6EAED8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="9"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="14" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="12" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="PromptText"
                   FontSize="15"
                   TextWrapping="Wrap"
                   Foreground="#1D2A36"
                   Text="Enter your master password." />

        <StackPanel Grid.Row="2">
            <TextBlock Text="Master Password" Foreground="#3C4A57" Margin="0,0,0,6" />
            <PasswordBox x:Name="PrimaryPasswordBox" FontSize="15" Padding="8" />
        </StackPanel>

        <StackPanel x:Name="ConfirmPanel" Grid.Row="4">
            <TextBlock Text="Confirm Password" Foreground="#3C4A57" Margin="0,0,0,6" />
            <PasswordBox x:Name="ConfirmPasswordBox" FontSize="15" Padding="8" />
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel"
                    Style="{StaticResource DialogButtonStyle}"
                    Click="CancelButton_Click" />
            <Button x:Name="ActionButton"
                    Content="Unlock"
                    Style="{StaticResource DialogButtonStyle}"
                    Margin="0"
                    Click="ActionButton_Click" />
        </StackPanel>
    </Grid>
</Window>
