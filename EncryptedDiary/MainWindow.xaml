<Window x:Class="EncryptedDiary.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Encrypted Diary"
        Width="1280"
        Height="820"
        MinWidth="980"
        MinHeight="680"
        Background="Transparent"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        SourceInitialized="Window_SourceInitialized"
        Loaded="Window_Loaded"
        Closing="Window_Closing"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Window.Resources>
        <LinearGradientBrush x:Key="NotebookShellBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#96F5F7FB" Offset="0" />
            <GradientStop Color="#88F3F6F8" Offset="1" />
        </LinearGradientBrush>

        <DrawingBrush x:Key="NotebookLinesBrush"
                      TileMode="Tile"
                      ViewportUnits="Absolute"
                      Viewport="0,0,1,28"
                      Stretch="Fill">
            <DrawingBrush.Drawing>
                <GeometryDrawing Brush="#03FFFFFF" Geometry="M0,0 L1,0 1,28 0,28 Z">
                    <GeometryDrawing.Pen>
                        <Pen Brush="#2837648E" Thickness="0.8" StartLineCap="Round" EndLineCap="Round" />
                    </GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>

        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="13,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#1E2A38" />
            <Setter Property="Background" Value="#E2FFFFFF" />
            <Setter Property="BorderBrush" Value="#7EB4D7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F2FFFFFF" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#CFE9FF" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Background" Value="#FFECEC" />
            <Setter Property="BorderBrush" Value="#D38B8B" />
            <Setter Property="Foreground" Value="#632C2C" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#FFF4F4" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#F9D7D7" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToolButtonStyle" TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
            <Setter Property="Padding" Value="9,5" />
            <Setter Property="MinWidth" Value="38" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="BorderBrush" Value="#89BBDC" />
            <Setter Property="Background" Value="#ECFFFFFF" />
        </Style>

        <Style x:Key="ComboStyle" TargetType="ComboBox">
            <Setter Property="Height" Value="32" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#89BBDC" />
            <Setter Property="Background" Value="#F6FFFFFF" />
            <Setter Property="Padding" Value="6,2" />
        </Style>

        <Style x:Key="ModernScrollThumbStyle" TargetType="Thumb">
            <Setter Property="Background" Value="#8E6D7D8E" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Margin="2"
                                CornerRadius="8"
                                Background="{TemplateBinding Background}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#A17C8FA3" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track"
                                   Orientation="{TemplateBinding Orientation}"
                                   IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Opacity="0" IsHitTestVisible="False" />
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ModernScrollThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Opacity="0" IsHitTestVisible="False" />
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Border Margin="20"
                CornerRadius="26"
                BorderThickness="1"
                BorderBrush="#67FFFFFF"
                Background="{StaticResource NotebookShellBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        CornerRadius="26,26,0,0"
                        Background="#74FFFFFF"
                        BorderBrush="#38AAC4DD"
                        BorderThickness="0,0,0,1">
                    <Grid Margin="18,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="Encrypted Diary"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="#263542" />
                            <TextBlock Text="Private notes with Rich Text + Markdown"
                                       Margin="0,2,0,0"
                                       Foreground="#566170" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="NewEntryButton"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Content="New Entry"
                                    Click="NewEntryButton_Click" />
                            <Button x:Name="DeleteEntryButton"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Content="Delete Entry"
                                    Click="DeleteEntryButton_Click" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1" Margin="18,14,18,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="310" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            CornerRadius="16"
                            BorderBrush="#44B6D4F0"
                            BorderThickness="1"
                            Background="#88FFFFFF"
                            Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Entries"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       Foreground="#2B3A47" />
                            <ListBox x:Name="EntryList"
                                     Grid.Row="2"
                                     SelectionChanged="EntryList_SelectionChanged"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Foreground="#1F2B37"
                                     ScrollViewer.CanContentScroll="True"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,10"
                                                Padding="10"
                                                CornerRadius="10"
                                                BorderBrush="#3DA4C8E8"
                                                BorderThickness="1"
                                                Background="#84F9FCFF">
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayTitle}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding DisplayUpdated}"
                                                           Margin="0,4,0,0"
                                                           FontSize="11"
                                                           Foreground="#59677A" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Center" Background="#14FFFFFF" />

                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                CornerRadius="14"
                                BorderBrush="#44B6D4F0"
                                BorderThickness="1"
                                Background="#8CFFFFFF"
                                Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="170" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TitleBox"
                                         Grid.Column="0"
                                         FontSize="16"
                                         FontWeight="SemiBold"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         VerticalContentAlignment="Center"
                                         Foreground="#1D2937"
                                         TextChanged="TitleBox_TextChanged" />
                                <ComboBox x:Name="ModeCombo"
                                          Grid.Column="2"
                                          Style="{StaticResource ComboStyle}"
                                          SelectionChanged="ModeCombo_SelectionChanged">
                                    <ComboBoxItem Tag="RichText" Content="Rich Text" />
                                    <ComboBoxItem Tag="Markdown" Content="Markdown" />
                                </ComboBox>
                                <Button x:Name="SaveButton"
                                        Grid.Column="4"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="0"
                                        Content="Save"
                                        Click="SaveButton_Click" />
                            </Grid>
                        </Border>

                        <Border x:Name="RichFormattingToolbar"
                                Grid.Row="2"
                                CornerRadius="12"
                                BorderBrush="#44B6D4F0"
                                BorderThickness="1"
                                Background="#86FFFFFF"
                                Padding="10">
                            <WrapPanel VerticalAlignment="Center">
                                <Button x:Name="BoldButton"
                                        Style="{StaticResource ToolButtonStyle}"
                                        FontWeight="Bold"
                                        Content="B"
                                        Click="BoldButton_Click" />
                                <Button x:Name="ItalicButton"
                                        Style="{StaticResource ToolButtonStyle}"
                                        FontStyle="Italic"
                                        Content="I"
                                        Click="ItalicButton_Click" />
                                <Button x:Name="UnderlineButton"
                                        Style="{StaticResource ToolButtonStyle}"
                                        Content="U"
                                        Click="UnderlineButton_Click" />
                                <TextBlock Margin="6,6,4,0" Foreground="#2E3C4B" Text="Font Size" />
                                <ComboBox x:Name="FontSizeCombo"
                                          Width="88"
                                          Style="{StaticResource ComboStyle}"
                                          SelectionChanged="FontSizeCombo_SelectionChanged">
                                    <ComboBoxItem Content="12" />
                                    <ComboBoxItem Content="14" />
                                    <ComboBoxItem Content="16" />
                                    <ComboBoxItem Content="18" />
                                    <ComboBoxItem Content="20" />
                                    <ComboBoxItem Content="24" />
                                    <ComboBoxItem Content="28" />
                                    <ComboBoxItem Content="32" />
                                </ComboBox>
                                <TextBlock Margin="12,6,4,0" Foreground="#2E3C4B" Text="Font Color" />
                                <ComboBox x:Name="FontColorCombo"
                                          Width="160"
                                          Style="{StaticResource ComboStyle}"
                                          SelectionChanged="FontColorCombo_SelectionChanged">
                                    <ComboBoxItem Tag="#1C2A37" Content="Ink Blue" />
                                    <ComboBoxItem Tag="#0A5C99" Content="Ocean Blue" />
                                    <ComboBoxItem Tag="#226B2A" Content="Leaf Green" />
                                    <ComboBoxItem Tag="#7A2D8F" Content="Plum" />
                                    <ComboBoxItem Tag="#9A4F00" Content="Amber" />
                                    <ComboBoxItem Tag="#9A1F1F" Content="Crimson" />
                                </ComboBox>
                                <Button x:Name="ClearFormatButton"
                                        Style="{StaticResource ToolButtonStyle}"
                                        Margin="12,0,0,0"
                                        MinWidth="88"
                                        Content="Clear"
                                        Click="ClearFormatButton_Click" />
                            </WrapPanel>
                        </Border>

                        <Grid Grid.Row="4">
                            <Grid x:Name="RichEditorContainer">
                                <Border CornerRadius="16"
                                        BorderBrush="#44B6D4F0"
                                        BorderThickness="1"
                                        Background="{StaticResource NotebookLinesBrush}"
                                        Padding="14">
                                    <RichTextBox x:Name="RichEditor"
                                                 BorderThickness="0"
                                                 Background="#05FFFFFF"
                                                 FontSize="16"
                                                 Foreground="#1C2A37"
                                                 TextChanged="RichEditor_TextChanged"
                                                 SelectionChanged="RichEditor_SelectionChanged"
                                                 VerticalScrollBarVisibility="Auto"
                                                 AcceptsTab="True" />
                                </Border>
                            </Grid>

                            <Border x:Name="MarkdownEditorContainer"
                                    Visibility="Collapsed"
                                    CornerRadius="16"
                                    BorderBrush="#44B6D4F0"
                                    BorderThickness="1"
                                    Background="#8EFFFFFF"
                                    Padding="10">
                                <TextBox x:Name="MarkdownEditor"
                                         FontFamily="Consolas"
                                         FontSize="15"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         HorizontalScrollBarVisibility="Disabled"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         TextChanged="MarkdownEditor_TextChanged" />
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>

                <Border Grid.Row="2"
                        CornerRadius="0,0,26,26"
                        Background="#6AFFFFFF"
                        BorderBrush="#33AAC4DD"
                        BorderThickness="0,1,0,0"
                        Padding="16,10">
                    <TextBlock x:Name="StatusText"
                               Foreground="#354555"
                               Text="Locked vault. Enter your master password." />
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
